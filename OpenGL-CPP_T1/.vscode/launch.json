{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Executar e depurar ProgOpenGL",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\ProgOpenGL.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Habilitar pretty-printing no GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Usar sintaxe Intel no disassembly",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Compilar projeto OpenGL"
        }
    ]
}